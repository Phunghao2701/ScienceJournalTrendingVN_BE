{
  "env": {
    "node": true,
    "es2022": true
  },
  "extends": "eslint:recommended",
  "parserOptions": {
    "sourceType": "module",
    "ecmaVersion": "latest"
  },
  "rules": {
    "no-unused-vars": "off",
    "no-undef": "error",
    "no-useless-catch": "off",
    "no-control-regex": "off",
    "no-constant-condition": "off",
    "no-useless-escape": "off"
  }
}
